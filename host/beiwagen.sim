# the OP-1 plays a 1 kHz sine at -6 dBFS on the source pair and records the FM-1: MASTER full, half, off; then the
# pages: HOME tracks, setup (knobs turned: lit, then dim), USB, scope (SELECT), the FX section (GLO), the keys, HOME
frames 20
usbtone 1000 -6
usbrec 2
frames 40
screen build/host/out/beiwagen.ppm
master 512
frames 40
screen build/host/out/beiwagen_half.ppm
master 0
frames 40
master 1023
knob ALGO 1
frames 10
screen build/host/out/beiwagen_tracks.ppm
knob SELECT 1
frames 2
knob K2 1
knob K3 2
frames 10
screen build/host/out/beiwagen_setup.ppm
frames 100
screen build/host/out/beiwagen_setup_dim.ppm
knob SELECT 1
frames 60
screen build/host/out/beiwagen_usb.ppm
knob SELECT 1
frames 120
screen build/host/out/beiwagen_scope.ppm
leds
btn GLO down
frames 1
btn GLO up
frames 5
btn GLO down
frames 1
btn GLO up
knob SELECT 3
knob K1 -10
frames 10
btn GLO down
frames 1
btn GLO up
frames 10
screen build/host/out/beiwagen_fx.ppm
key 0 down
frames 2
key 0 up
btn OCT_UP down
frames 1
btn OCT_UP up
key 12 down
frames 2
key 12 up
frames 2
btn HOME down
frames 1
btn HOME up
frames 5
screen build/host/out/beiwagen_back.ppm
leds
wav build/host/out/beiwagen.wav
